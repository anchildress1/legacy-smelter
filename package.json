{
  "name": "legacy-smelter",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "serve": "npm run build && npm run start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:api": "vitest run scripts/server.analyze.integration.test.ts",
    "test:api:emulator": "firebase emulators:exec --only firestore --project demo-legacy-smelter \"vitest run --config vitest.api-emulator.config.ts\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-legacy-smelter \"vitest run --config vitest.rules.config.ts\"",
    "test:proof": "npm run lint && npm run test:run && npm run test:api:emulator && npm run test:rules",
    "clean": "rm -rf dist",
    "lint": "oxlint --deny-warnings && npm run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "compression": "^1.8.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "howler": "^2.2.4",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "oxlint": "^1.89.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    },
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.12.0"
    },
    "gaxios@^6.7.0": {
      "uuid": "11.1.1"
    }
  },
  "volta": {
    "node": "24.21.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
